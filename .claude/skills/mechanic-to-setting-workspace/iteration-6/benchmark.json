        {
          "text": "\u8bbe\u5b9a\u5305\u542b\u5177\u4f53\u7684\u3001\u5947\u602a\u7684\u3001\u8ba9\u4eba\u8bb0\u4f4f\u7684\u7ec6\u8282",
          "passed": true,
          "evidence": "\u65b9\u6848\u4e00\uff1a\u5de5\u5361\u7167\u7247'\u597d\u50cf\u662f\u4e09\u5e74\u540e\u7684\u4f60'\u3001\u5458\u5de5\u624b\u518c\u7b2c1-7\u7248'\u5df2\u5f52\u6863\uff08\u4e0d\u53ef\u67e5\u9605\uff09'\u3001\u95ea\u4e86\u4e09\u4e2a\u6708\u7684\u706f\u7ba1\u65c1\u8d34\u7740\u7b2c37\u53f7\u5de5\u5355\u3001\u51fa\u6599\u53e3\u53eb\u7532\u6e20\u4e59\u6e20\u4e19\u6e20\u4e14\u5165\u804cPPT\u7b2c14\u9875\u8bf4'\u5386\u53f2\u9057\u7559\u547d\u540d\u8bf7\u52ff\u4fee\u6539'\u3001\u5706\u73e0\u7b14\u4e0a\u523b\u7740'\u9648\u8001\u5e08\u7684'\u3002\u65b9\u6848\u4e8c\uff1a\u788e\u82b1\u7761\u8863\u963f\u59e8\u6de1\u5b9a\u6307\u9633\u53f0\u8bf4'\u4eca\u5929\u54c1\u8d28\u4e0d\u9519\u6bd4\u4e0a\u6b21\u70c2\u7684\u5f3a'\u3001\u7406\u53d1\u5e97\u8001\u677f\u8bf4'\u597d\u50cf\u6709\u4eba\u60f3\u5728\u6211\u8fd9\u5f00\u4e2a\u529e\u516c\u5ba4'\u3001\u4ece\u672a\u5b58\u5728\u8fc7\u7684\u5c0f\u5b66\u6821\u540d\u5370\u5728\u4fe1\u7eb8\u4e0a\u3002"
        },
        {
          "text": "mystery\u4ece\u4e00\u5f00\u59cb\u5c31\u7ec7\u5165\u8bbe\u5b9a\uff0c\u800c\u975e\u4e8b\u540e\u9644\u52a0",
