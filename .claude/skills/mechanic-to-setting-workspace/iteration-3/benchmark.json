        },
        {
          "text": "\u8bcd\u7f00\u7cfb\u7edf\u5728\u8bbe\u5b9a\u4e2d\u6709\u5bf9\u5e94\u89e3\u91ca",
          "passed": true,
          "evidence": "\u6f02\u6d41\u90ae\u5c40\u5c06\u8bcd\u7f00\u6620\u5c04\u4e3a\u6c14\u6d41\u6027\u683c\uff08\u6696\u6d41=\u63d0\u7eaf\u7684\u3001\u4e71\u6d41=\u7a00\u788e\u7684\u7b49\uff09\uff0c\u5360\u661f\u672f\u58eb\u6620\u5c04\u4e3a\u5929\u8c61\u72b6\u6001\uff08\u6ee1\u6708=\u63d0\u7eaf\u7684\u3001\u65e5\u8680=\u6ce2\u52a8\u7684\u3001\u6d41\u661f\u96e8=\u7a00\u788e\u7684\uff09\uff0c\u6f6e\u6c50\u6742\u8d27\u94fa\u6620\u5c04\u4e3a\u6f6e\u6c50\u72b6\u6001\u3002\u591a\u4e2a\u8bbe\u5b9a\u8be6\u7ec6\u89e3\u91ca\u4e86\u6bcf\u79cd\u8bcd\u7f00\u3002"
        },
        {
          "text": "\u5408\u6210\u5347\u7ea7\u673a\u5236\u5728\u8bbe\u5b9a\u4e2d\u6709\u81ea\u7136\u5bf9\u5e94",
