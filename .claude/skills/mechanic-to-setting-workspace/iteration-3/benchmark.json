        },
        {
          "text": "\u8f93\u51fa\u5305\u542b\u673a\u5236\u5206\u89e3\u90e8\u5206",
          "passed": true,
          "evidence": "\u6709\u5b8c\u6574\u7684\u300c\u673a\u5236\u8eab\u4efd\u5206\u6790\u300d\u90e8\u5206\uff0c\u5305\u542b\u6838\u5fc3\u5faa\u73af\u3001\u8d44\u6e90\u52a8\u6001\u3001\u5f20\u529b\u7ed3\u6784\u3001\u9012\u8fdb\u5f27\u7ebf\u3001\u4ea4\u4e92\u6a21\u578b\u3001\u89c6\u89d2\u4e0e\u8282\u594f\u516d\u4e2a\u7ef4\u5ea6\u7684\u5206\u6790\u3002"
        },
        {
          "text": "\u81f3\u5c11\u5448\u73b05\u4e2a\u4e0d\u540c\u7684\u8bbe\u5b9a\u6982\u5ff5",
          "passed": true,
